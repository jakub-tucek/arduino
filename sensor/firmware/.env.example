WIFI_SSID=your-wifi-ssid
WIFI_PASSWORD=your-wifi-password
API_ENDPOINT=https://sensors.example.com/api/readings
API_KEY=your-api-key
DEVICE_NAME=living-room
SENSOR_ID=room
# Defaults to SENSOR_ID; use a unique DNS hostname (letters/digits/hyphens).
# WIFI_HOSTNAME=living-room-sensor
LOCATION=home
GROUP=room
TEMPERATURE_OFFSET_C=0.0
# Optional override for a different trusted root CA PEM file:
# API_ROOT_CA_FILE=your-root-ca.pem
