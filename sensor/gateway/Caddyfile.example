# Example only. Do not commit the real Caddyfile with public domain,
# credentials, local ports, or private paths filled in.
#
# Copy to the server as /etc/caddy/Caddyfile and replace:
# - iot.example.com with the public IoT hostname
# - localhost ports with the real local service ports
# - basicauth hash with a real value from: caddy hash-password

{
	email admin@example.com
}

iot.example.com {
	# Dedicated API path for devices and ingestion clients.
	@api path /api /api/*
	handle @api {
		reverse_proxy 127.0.0.1:8095
	}

	# Monitoring UIs are exposed under the same hostname and protected by auth.
	# Set Grafana root_url to https://<host>/grafana/; serve_from_sub_path=false.
	redir /grafana /grafana/ 308
	handle_path /grafana/* {
		basicauth {
			admin <caddy-hashed-password>
		}
		reverse_proxy 127.0.0.1:3000
	}

	# Prometheus external-url includes /prometheus/; route-prefix=/.
	redir /prometheus /prometheus/ 308
	handle_path /prometheus/* {
		basicauth {
			admin <caddy-hashed-password>
		}
		reverse_proxy 127.0.0.1:9090
	}

	# Public landing page with links to API/Grafana/Prometheus.
	handle {
		root * /var/www/iot
		file_server
	}
}
